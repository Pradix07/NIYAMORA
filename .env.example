# NIYAMORA Backend Environment Configuration Example
PROJECT_NAME="NIYAMORA"
ENVIRONMENT="development"
SECRET_KEY="replace_with_secure_random_key_in_production"

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL="sqlite:///./niyamora_dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/niyamora"

# Storage Configuration
STORAGE_DIR="./backend/storage/uploads"

# Frontend Base URL
VITE_API_BASE_URL="http://127.0.0.1:8000"
